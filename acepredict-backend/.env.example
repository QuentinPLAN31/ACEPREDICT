# --- Database ---
DATABASE_URL=postgresql://acepredict:acepredict@localhost:5432/acepredict

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_LIFETIME=price_xxx
# Facturation annuelle (tarif dégressif affiché sur la page Pricing) — deux
# Price Stripe distincts à créer en plus des mensuels ci-dessus, sur le même
# Product Starter/Pro respectivement (Stripe Dashboard > Produits > + Price).
STRIPE_PRICE_STARTER_ANNUAL=price_xxx
STRIPE_PRICE_PRO_ANNUAL=price_xxx
# Pack ponctuel (+5 analyses, paiement unique, pas d'abonnement) — un seul
# Price Stripe en mode "one-time" (pas "recurring") à créer.
STRIPE_PRICE_PACK5=price_xxx

# --- Live data (calendrier des prochains matchs, GET /matches/upcoming) ---
# Compte gratuit sur https://livetennisapi.com/subscribe/free (pas de CB requise).
# Quota serré (~30 req/min, ~100 req/jour) : app/services/livetennis_client.py
# met en cache en mémoire les lookups joueur/tournoi/liste (cf. son en-tête)
# pour rester dans ce quota même avec plusieurs utilisateurs simultanés.
# Sans cette clé, l'endpoint /matches/upcoming renvoie une liste vide et le
# frontend laisse l'utilisateur lancer l'analyse sans conditions de match.
LIVETENNISAPI_KEY=
LIVETENNISAPI_BASE_URL=https://api.livetennisapi.com/api/public/v1

# --- Probabilité de marché (Polymarket, optionnel) ---
# API Gamma publique, SANS clé requise. Remplace The Odds API (abandonnée :
# payante et peu fiable). Active par défaut ; passer à false pour désactiver
# sans toucher au code si jamais elle devient instable.
POLYMARKET_ENABLED=true
POLYMARKET_BASE_URL=https://gamma-api.polymarket.com

# --- Météo (conditions de match, optionnel) ---
# Deux fournisseurs interchangeables (cf. app/services/weather_providers.py) :
#   - openweathermap (défaut) : compte gratuit sur https://openweathermap.org/api
#     (pas de CB requise), clé requise ci-dessous. Pas de restriction connue
#     sur l'usage commercial -- c'est celui à utiliser si le site est monétisé.
#   - open-meteo : gratuite et SANS clé (https://open-meteo.com/), mais son
#     offre gratuite est réservée par sa licence à un usage NON COMMERCIAL
#     (cf. https://open-meteo.com/en/pricing). Pratique en dev/démo/projet
#     scolaire sans même créer de compte -- à NE JAMAIS activer en prod sur
#     un site monétisé sans souscrire à leur offre commerciale.
# Sans clé OpenWeatherMap et sans WEATHER_PROVIDER=open-meteo, l'analyse
# fonctionne normalement, juste sans le volet météo.
WEATHER_PROVIDER=openweathermap
WEATHER_API_KEY=

# --- Analyse approfondie générée par IA (commentaire en langage naturel, optionnel) ---
# Clé sur https://console.anthropic.com/ (compte payant à l'usage, pas d'offre
# gratuite — chaque analyse déclenche un appel facturé). Sans cette clé,
# l'analyse fonctionne normalement, juste sans le paragraphe de commentaire.
ANTHROPIC_API_KEY=
# Vérifier le modèle le plus récent sur https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- E-mail (réinitialisation de mot de passe) ---
# SMTP générique — fonctionne avec Gmail (créer un "mot de passe d'application"
# sur myaccount.google.com/apppasswords, PAS ton vrai mot de passe Gmail),
# Brevo/Mailjet (offre gratuite), ou le SMTP de ton hébergeur.
# Sans ces variables : le lien de réinitialisation est juste affiché dans les
# logs du serveur (uvicorn) au lieu d'être envoyé par e-mail — pratique pour
# tester le flux tout de suite, à configurer avant de mettre le site en ligne.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AcePredict <app@acepredict.com>
# En local (fichier ouvert en double-clic) laisse cette valeur : le frontend
# construit le lien de réinitialisation à partir d'ici.
FRONTEND_BASE_URL=http://localhost:5500

# --- Misc ---
ENV=development
# "null" autorise le frontend ouvert en double-cliquant (file://) à appeler l'API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5500,http://localhost:8080,null
