# Copie ce fichier vers .env sur ton hébergeur (ou configure ces variables
# dans l'interface de l'hébergeur — Railway/Render le font sans fichier).
# NE JAMAIS committer un vrai .env avec des vraies clés dans git.

# --- Database ---
# Railway/Render fournissent cette URL automatiquement quand tu ajoutes un
# service PostgreSQL managé — copie-la depuis leur dashboard, ne mets pas
# localhost ici en production.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Auth ---
# Génère une vraie valeur aléatoire, ex: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REMPLACE_MOI_PAR_UNE_VRAIE_VALEUR_ALEATOIRE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Stripe (mode LIVE, pas test, une fois ton compte Stripe activé) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_LIFETIME=price_...

# --- Live data (optionnel) ---
LIVETENNISAPI_KEY=
LIVETENNISAPI_BASE_URL=https://api.livetennisapi.com/v1
THE_ODDS_API_KEY=

# --- Misc ---
ENV=production
# Remplace par ton vrai domaine une fois le frontend déployé. Ne jamais
# laisser "null" ni un localhost en prod.
CORS_ORIGINS=https://TON-DOMAINE.com
